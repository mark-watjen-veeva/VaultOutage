<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script>
(function () {
  'use strict';

  var HEADERS = [];
  var COL = {};
  var ALL_ROWS = [];
  var FILTERED_ROWS = [];
  var POD_OPTIONS = [];
  var POD_LOOKUP = {};
  var chart = null;
  var chartCustomers = null;
  var chartVaultTypes = null;

  var TABLE_PAGE_SIZE = 25;
  var NONPROD_HIDDEN = 0;

  // Columns shown in the Vault Details table only. Filtering, stats, charts,
  // the POD picker, and CSV export all continue to use the full row/HEADERS
  // data regardless of this list.
  var TABLE_DISPLAY_COLUMNS = ['Customer Name', 'Family', 'Applications'];

  var state = {
    search: '',
    pods: [],
    prodOnly: true,
    tablePage: 1,
    tableSortCol: null,
    tableSortDir: 1
  };

  function $(id) { return document.getElementById(id); }

  function podIdx() { return COL['POD'] !== undefined ? COL['POD'] : 4; }
  function custIdx() { return COL['Customer Name'] !== undefined ? COL['Customer Name'] : 5; }
  function vtypeIdx() { return COL['Vault Type'] !== undefined ? COL['Vault Type'] : 9; }
  function domainTypeIdx() { return COL['Domain Type'] !== undefined ? COL['Domain Type'] : 4; }

  function isProductionRow(row) {
    var dt = String(row[domainTypeIdx()] == null ? '' : row[domainTypeIdx()]).trim().toLowerCase();
    return dt === 'production';
  }

  function initTheme() {
    var savedTheme = localStorage.getItem('app-theme');
    var isDark = savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches);
    if (isDark) {
      document.documentElement.classList.add('dark');
      document.documentElement.classList.remove('light');
    } else {
      document.documentElement.classList.add('light');
      document.documentElement.classList.remove('dark');
    }

    $('themeToggleBtn').addEventListener('click', function () {
      var isCurrentlyDark = document.documentElement.classList.contains('dark');
      if (isCurrentlyDark) {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        localStorage.setItem('app-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
        localStorage.setItem('app-theme', 'dark');
      }
      renderChart();
      renderCustomersChart();
      renderVaultTypesChart();
    });
  }

  function setError(msg) {
    var el = $('errorBanner');
    el.innerHTML = msg ? '<div class="bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800 rounded-lg p-3.5 mb-4 text-xs font-medium flex items-center gap-2"><svg class="w-4 h-4 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>' + escapeHtml(msg) + '</div>' : '';
  }

  function escapeHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  var hasLoadedOnce = false;

  function showLoadingState() {
    $('loadingState').classList.remove('hidden');
    $('dashboardContent').classList.add('hidden');
  }

  function hideLoadingState() {
    $('loadingState').classList.add('hidden');
    $('dashboardContent').classList.remove('hidden');
  }

  function loadData() {
    if (!hasLoadedOnce) showLoadingState();
    $('metaText').textContent = 'Syncing...';
    setError('');
    google.script.run
      .withSuccessHandler(onDataLoaded)
      .withFailureHandler(function (err) {
        setError('Failed to load data: ' + (err && err.message ? err.message : err));
        $('metaText').textContent = 'Sync failed';
        hideLoadingState();
      })
      .getData();
  }

  function onDataLoaded(payload) {
    HEADERS = payload.headers;
    HEADERS.forEach(function (h, i) { COL[h] = i; });
    ALL_ROWS = payload.rows;
    var fetched = payload.fetchedAt ? new Date(payload.fetchedAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : '';
    $('metaText').textContent = 'Updated ' + fetched;
    buildTableHead();
    populatePodOptions();
    renderPodPickerList('');
    updatePodLabel();
    applyFilters();
    hasLoadedOnce = true;
    hideLoadingState();
  }

  function buildTableHead() {
    var tr = $('tableHead');
    tr.innerHTML = '';
    TABLE_DISPLAY_COLUMNS.forEach(function (h) {
      var idx = COL[h];
      var th = document.createElement('th');
      th.textContent = h;
      th.className = 'px-3 py-2.5 cursor-pointer hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors select-none whitespace-nowrap font-semibold';
      th.dataset.idx = idx;
      th.addEventListener('click', function () {
        if (state.tableSortCol === idx) {
          state.tableSortDir *= -1;
        } else {
          state.tableSortCol = idx;
          state.tableSortDir = 1;
        }
        state.tablePage = 1;
        renderTable();
      });
      tr.appendChild(th);
    });
  }

  function applyFilters() {
    var term = state.search.trim().toLowerCase();
    var pods = state.pods;

    var baseRows = ALL_ROWS.filter(function (row) {
      if (pods.length) {
        var podVal = String(row[podIdx()] || '').trim().toUpperCase();
        if (pods.indexOf(podVal) === -1) return false;
      }
      if (term) {
        var hit = false;
        for (var i = 0; i < row.length; i++) {
          if (String(row[i] == null ? '' : row[i]).toLowerCase().indexOf(term) !== -1) {
            hit = true;
            break;
          }
        }
        if (!hit) return false;
      }
      return true;
    });

    if (state.prodOnly) {
      FILTERED_ROWS = baseRows.filter(isProductionRow);
      NONPROD_HIDDEN = baseRows.length - FILTERED_ROWS.length;
    } else {
      FILTERED_ROWS = baseRows;
      NONPROD_HIDDEN = 0;
    }

    // 1. Total Vault Count
    $('statVaults').textContent = FILTERED_ROWS.length.toLocaleString();

    // 2. Distinct Customer Names (Targeting Column F: Customer Name or Index 5 fallback)
    var uniqueCust = {};
    FILTERED_ROWS.forEach(function(r) {
      var customerVal = String(r[custIdx()] == null ? '' : r[custIdx()]).trim();
      if (customerVal) uniqueCust[customerVal] = true;
    });
    $('statCustomers').textContent = Object.keys(uniqueCust).length.toLocaleString();

    // 3. Impacted POD Count (Targeting Column POD or Index 4 fallback)
    var uniquePods = {};
    FILTERED_ROWS.forEach(function(r) {
      var podVal = String(r[podIdx()] == null ? '' : r[podIdx()]).trim();
      if (podVal) uniquePods[podVal] = true;
    });
    $('statPods').textContent = Object.keys(uniquePods).length.toLocaleString();

    state.tablePage = 1;
    renderAll();
  }

  function renderAll() {
    renderChart();
    renderCustomersChart();
    renderVaultTypesChart();
    renderTable();
  }

  // ---------- Charts ----------
  function topEntries(idx, limit) {
    var counts = {};
    FILTERED_ROWS.forEach(function (row) {
      var val = row[idx];
      var key = String(val == null || val === '' ? '(blank)' : val);
      counts[key] = (counts[key] || 0) + 1;
    });
    var entries = Object.keys(counts).map(function (k) { return [k, counts[k]]; });
    entries.sort(function (a, b) { return b[1] - a[1]; });
    return entries.slice(0, limit || 10);
  }

  function buildBarChart(canvasId, labels, data, color) {
    var ctx = document.getElementById(canvasId).getContext('2d');
    var isDark = document.documentElement.classList.contains('dark');
    var textColor = isDark ? '#94a3b8' : '#64748b';
    var gridColor = isDark ? '#1e293b' : '#f1f5f9';

    return new Chart(ctx, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{
          label: 'Vaults',
          data: data,
          backgroundColor: color,
          borderRadius: 4
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: isDark ? '#0f172a' : '#1e293b',
            titleColor: '#ffffff',
            bodyColor: '#ffffff',
            titleFont: { family: 'Inter', size: 11 },
            bodyFont: { family: 'Inter', size: 11 },
            padding: 8,
            cornerRadius: 6
          }
        },
        scales: {
          x: {
            beginAtZero: true,
            ticks: { precision: 0, font: { family: 'Inter', size: 10 }, color: textColor },
            grid: { color: gridColor }
          },
          y: {
            ticks: { font: { family: 'Inter', size: 10 }, color: textColor },
            grid: { display: false }
          }
        }
      }
    });
  }

  function renderChart() {
    var dim = $('chartDim').value;
    var idx = COL[dim];
    var top = topEntries(idx, 10);
    var labels = top.map(function (e) { return e[0]; });
    var data = top.map(function (e) { return e[1]; });

    if (chart) chart.destroy();
    chart = buildBarChart('summaryChart', labels, data, '#2563eb');
  }

  function renderCustomersChart() {
    var top = topEntries(custIdx(), 10);
    var labels = top.map(function (e) { return e[0]; });
    var data = top.map(function (e) { return e[1]; });

    if (chartCustomers) chartCustomers.destroy();
    chartCustomers = buildBarChart('customersChart', labels, data, '#059669');
  }

  function renderVaultTypesChart() {
    var top = topEntries(vtypeIdx(), 10);
    var labels = top.map(function (e) { return e[0]; });
    var data = top.map(function (e) { return e[1]; });

    if (chartVaultTypes) chartVaultTypes.destroy();
    chartVaultTypes = buildBarChart('vaultTypesChart', labels, data, '#7c3aed');
  }

  // ---------- Flat vault details table ----------
  function renderTable() {
    var rows = FILTERED_ROWS.slice();
    if (state.tableSortCol !== null) {
      var idx = state.tableSortCol, dir = state.tableSortDir;
      rows.sort(function (a, b) {
        var av = a[idx], bv = b[idx];
        var an = parseFloat(av), bn = parseFloat(bv);
        var cmp;
        if (!isNaN(an) && !isNaN(bn) && av !== '' && bv !== '') {
          cmp = an - bn;
        } else {
          cmp = String(av == null ? '' : av).localeCompare(String(bv == null ? '' : bv));
        }
        return cmp * dir;
      });
    }

    Array.prototype.forEach.call($('tableHead').children, function (th) {
      var thIdx = Number(th.dataset.idx);
      th.classList.toggle('sorted', thIdx === state.tableSortCol);
      th.classList.toggle('asc', thIdx === state.tableSortCol && state.tableSortDir === 1);
    });

    var totalPages = Math.max(1, Math.ceil(rows.length / TABLE_PAGE_SIZE));
    state.tablePage = Math.min(Math.max(1, state.tablePage), totalPages);
    var start = (state.tablePage - 1) * TABLE_PAGE_SIZE;
    var pageRows = rows.slice(start, start + TABLE_PAGE_SIZE);

    var tbody = $('tableBody');
    if (!pageRows.length) {
      tbody.innerHTML = '<tr><td colspan="' + TABLE_DISPLAY_COLUMNS.length + '" class="p-8 text-center text-slate-400 text-xs">No rows match the current filters.</td></tr>';
    } else {
      var html = '';
      pageRows.forEach(function (r) {
        html += '<tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">';
        TABLE_DISPLAY_COLUMNS.forEach(function (h) {
          var c = r[COL[h]];
          html += '<td class="px-3 py-2 whitespace-nowrap max-w-[200px] truncate" title="' + escapeHtml(c) + '">' + escapeHtml(c) + '</td>';
        });
        html += '</tr>';
      });
      tbody.innerHTML = html;
    }

    var rowCountText = rows.length.toLocaleString() + ' matching vault' + (rows.length === 1 ? '' : 's');
    if (state.prodOnly && NONPROD_HIDDEN > 0) {
      rowCountText += ' | ' + NONPROD_HIDDEN.toLocaleString() + ' non-production hidden';
    }
    $('tableRowCount').textContent = rowCountText;
    $('tablePageInfo').textContent = 'Page ' + state.tablePage + ' of ' + totalPages + ' (' + rows.length.toLocaleString() + ' rows)';
    $('tablePrev').disabled = state.tablePage <= 1;
    $('tableNext').disabled = state.tablePage >= totalPages;
  }

  // ---------- Export ----------
  function exportCsv() {
    if (!FILTERED_ROWS.length) { alert('No rows to export for the current filters.'); return; }
    var lines = [TABLE_DISPLAY_COLUMNS.map(csvCell).join(',')];
    FILTERED_ROWS.forEach(function (r) {
      var rowOut = TABLE_DISPLAY_COLUMNS.map(function (h) { return r[COL[h]]; });
      lines.push(rowOut.map(csvCell).join(','));
    });
    var blob = new Blob([lines.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    var stamp = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-');
    a.href = url;
    a.download = 'outage-impact-export-' + stamp + '.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function csvCell(v) {
    var s = v == null ? '' : String(v);
    if (/[",\n]/.test(s)) s = '"' + s.replace(/"/g, '""') + '"';
    return s;
  }

  // ---------- POD Picker ----------
  function populatePodOptions() {
    var counts = {};
    ALL_ROWS.forEach(function (row) {
      var pod = String(row[podIdx()] || '').trim();
      if (!pod) return;
      counts[pod] = (counts[pod] || 0) + 1;
    });

    POD_OPTIONS = Object.keys(counts)
      .map(function (pod) { return { pod: pod, count: counts[pod] }; })
      .sort(function (a, b) {
        // Natural alphanumeric sort (numerically orders numbers inside strings e.g., VV1-37 before VV1-1054)
        return a.pod.localeCompare(b.pod, undefined, { numeric: true, sensitivity: 'base' });
      });

    POD_LOOKUP = {};
    POD_OPTIONS.forEach(function (o) { POD_LOOKUP[o.pod.toUpperCase()] = o; });
  }

  function renderPodPickerList(term) {
    var filtered = POD_OPTIONS;
    if (term) {
      var t = term.trim().toLowerCase();
      filtered = POD_OPTIONS.filter(function (o) { return o.pod.toLowerCase().indexOf(t) !== -1; });
    }

    var html = '';
    if (!filtered.length) {
      html = '<div class="px-3 py-4 text-center text-[11px] text-slate-400">No matching PODs.</div>';
    } else {
      filtered.forEach(function (o) {
        var checked = state.pods.indexOf(o.pod.toUpperCase()) !== -1;
        html += '<label class="flex items-center justify-between gap-2 px-3 py-1.5 text-xs text-slate-200 hover:bg-slate-800 cursor-pointer">' +
          '<span class="flex items-center gap-2 truncate">' +
            '<input type="checkbox" data-pod="' + escapeHtml(o.pod) + '" class="pod-check rounded border-slate-600 bg-slate-800 text-brand-600 focus:ring-brand-500 focus:ring-offset-0"' + (checked ? ' checked' : '') + '>' +
            '<span class="truncate">' + escapeHtml(o.pod) + '</span>' +
          '</span>' +
          '<span class="text-[10px] text-slate-500 flex-shrink-0">' + o.count.toLocaleString() + '</span>' +
        '</label>';
      });
    }

    $('podPickerList').innerHTML = html;
    $('podPickerListMobile').innerHTML = html;
    wirePodCheckboxes();
  }

  function wirePodCheckboxes() {
    Array.prototype.forEach.call(document.querySelectorAll('.pod-check'), function (cb) {
      cb.addEventListener('change', function () {
        togglePod(cb.dataset.pod, cb.checked);
      });
    });
  }

  function togglePod(pod, isChecked) {
    var upper = pod.toUpperCase();
    var idx = state.pods.indexOf(upper);
    if (isChecked && idx === -1) state.pods.push(upper);
    if (!isChecked && idx !== -1) state.pods.splice(idx, 1);
    updatePodLabel();
    syncPodCheckboxStates();
    applyFilters();
  }

  function syncPodCheckboxStates() {
    Array.prototype.forEach.call(document.querySelectorAll('.pod-check'), function (cb) {
      cb.checked = state.pods.indexOf(cb.dataset.pod.toUpperCase()) !== -1;
    });
  }

  function updatePodLabel() {
    var label;
    if (!state.pods.length) {
      label = 'Select affected POD(s)...';
    } else if (state.pods.length <= 2) {
      label = state.pods.join(', ');
    } else {
      label = state.pods.length + ' PODs selected';
    }
    $('podPickerLabel').textContent = label;
    $('podPickerLabelMobile').textContent = label;
    $('podPickerLabel').classList.toggle('text-white', state.pods.length > 0);
    $('podPickerLabel').classList.toggle('text-slate-300', state.pods.length === 0);
    $('podPickerLabelMobile').classList.toggle('text-white', state.pods.length > 0);
    $('podPickerLabelMobile').classList.toggle('text-slate-300', state.pods.length === 0);
    renderPodChips();
  }

  // ---------- Selected PODs at-a-glance chips ----------
  function renderPodChips() {
    var row = $('podChipRow');
    if (!state.pods.length) {
      row.classList.add('hidden');
      row.innerHTML = '';
      return;
    }
    row.classList.remove('hidden');

    var sorted = state.pods.slice().sort(function (a, b) {
      return a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' });
    });

    var html = '<span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mr-1">Selected PODs</span>';
    sorted.forEach(function (podUpper) {
      var info = POD_LOOKUP[podUpper] || { pod: podUpper, count: 0 };
      html += '<span class="inline-flex items-center gap-1.5 pl-2.5 pr-1.5 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-[11px] font-medium text-slate-700 dark:text-slate-200 shadow-sm">' +
        escapeHtml(info.pod) +
        '<span class="text-slate-400 dark:text-slate-500 font-normal">&middot; ' + info.count.toLocaleString() + '</span>' +
        '<button type="button" data-pod="' + escapeHtml(info.pod) + '" class="pod-chip-remove ml-0.5 rounded-md p-0.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700 dark:text-slate-500 dark:hover:bg-slate-800 dark:hover:text-slate-200" aria-label="Remove ' + escapeHtml(info.pod) + '">' +
        '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>' +
        '</button></span>';
    });

    row.innerHTML = html;
    Array.prototype.forEach.call(row.querySelectorAll('.pod-chip-remove'), function (btn) {
      btn.addEventListener('click', function () { togglePod(btn.dataset.pod, false); });
    });
  }

  function selectAllPods(term) {
    var list = POD_OPTIONS;
    if (term) {
      var t = term.trim().toLowerCase();
      list = POD_OPTIONS.filter(function (o) { return o.pod.toLowerCase().indexOf(t) !== -1; });
    }
    list.forEach(function (o) {
      var upper = o.pod.toUpperCase();
      if (state.pods.indexOf(upper) === -1) state.pods.push(upper);
    });
    updatePodLabel();
    syncPodCheckboxStates();
    applyFilters();
  }

  function clearPodSelection() {
    state.pods = [];
    updatePodLabel();
    syncPodCheckboxStates();
    applyFilters();
  }

  function closeAllPodPanels() {
    $('podPickerPanel').classList.add('hidden');
    $('podPickerPanelMobile').classList.add('hidden');
  }

  function wirePodDropdown(btnId, panelId, searchId, selectAllId, clearId) {
    var btn = $(btnId), panel = $(panelId);
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var isOpen = !panel.classList.contains('hidden');
      closeAllPodPanels();
      if (!isOpen) {
        panel.classList.remove('hidden');
        if ($(searchId)) $(searchId).focus();
      }
    });
    if ($(searchId)) {
      $(searchId).addEventListener('input', function (e) {
        renderPodPickerList(e.target.value);
      });
    }
    if ($(selectAllId)) {
      $(selectAllId).addEventListener('click', function () {
        selectAllPods($(searchId) ? $(searchId).value : '');
      });
    }
    if ($(clearId)) {
      $(clearId).addEventListener('click', clearPodSelection);
    }
  }

  function setupPodPicker() {
    wirePodDropdown('podPickerBtn', 'podPickerPanel', 'podPickerSearch', 'podPickerSelectAll', 'podPickerClear');
    wirePodDropdown('podPickerBtnMobile', 'podPickerPanelMobile', 'podPickerSearchMobile', 'podPickerSelectAllMobile', 'podPickerClearMobile');

    document.addEventListener('click', function (e) {
      if (!e.target.closest('#podPickerWrap') && !e.target.closest('#podPickerPanelMobile') && !e.target.closest('#podPickerBtnMobile')) {
        closeAllPodPanels();
      }
    });
  }

  // ---------- Production Only toggle ----------
  function syncProdToggleUI() {
    ['prodOnlyToggle', 'prodOnlyToggleMobile'].forEach(function (btnId) {
      var btn = $(btnId);
      if (!btn) return;
      var track = btn.querySelector('.toggle-track');
      var knob = btn.querySelector('.toggle-knob');
      btn.setAttribute('aria-pressed', state.prodOnly ? 'true' : 'false');
      track.classList.toggle('bg-brand-600', state.prodOnly);
      track.classList.toggle('bg-slate-600', !state.prodOnly);
      knob.classList.toggle('translate-x-3.5', state.prodOnly);
      knob.classList.toggle('translate-x-0.5', !state.prodOnly);
    });
  }

  function setProdOnly(val) {
    state.prodOnly = val;
    syncProdToggleUI();
    applyFilters();
  }

  function setupProdToggle() {
    ['prodOnlyToggle', 'prodOnlyToggleMobile'].forEach(function (btnId) {
      var btn = $(btnId);
      if (!btn) return;
      btn.addEventListener('click', function () { setProdOnly(!state.prodOnly); });
    });
    syncProdToggleUI();
  }

  // ---------- Search sync ----------
  function syncSearchInputs(val) {
    $('search').value = val;
    if ($('searchMobile')) $('searchMobile').value = val;
    state.search = val;
    applyFilters();
  }

  // ---------- Wiring ----------
  var searchDebounce;
  function handleSearchInput(e) {
    clearTimeout(searchDebounce);
    var val = e.target.value;
    searchDebounce = setTimeout(function () { syncSearchInputs(val); }, 200);
  }

  $('search').addEventListener('input', handleSearchInput);
  if ($('searchMobile')) $('searchMobile').addEventListener('input', handleSearchInput);

  function clearAllFilters() {
    syncSearchInputs('');
    clearPodSelection();
  }

  $('clearBtn').addEventListener('click', clearAllFilters);
  if ($('clearBtnMobile')) $('clearBtnMobile').addEventListener('click', clearAllFilters);

  $('refreshBtn').addEventListener('click', loadData);
  $('exportBtn').addEventListener('click', exportCsv);
  $('chartDim').addEventListener('change', renderChart);

  $('tablePrev').addEventListener('click', function () { state.tablePage--; renderTable(); });
  $('tableNext').addEventListener('click', function () { state.tablePage++; renderTable(); });

  initTheme();
  setupPodPicker();
  setupProdToggle();
  loadData();
})();
</script>
