/**
 * P1 Outage Impact Lookup
 *
 * Reads Vault / Customer / POD data from the Google Sheet referenced by
 * the script property "VOSheet" and serves it to a single-page web app
 * (Index.html, assembled from Index.html + Stylesheet.html + JavaScript.html)
 * for search, filtering, charting, and CSV export.
 *
 * File layout:
 *   Code.gs        - backend: data access + template rendering
 *   Index.html     - page markup only
 *   Stylesheet.html - custom CSS, pulled into Index.html via include()
 *   JavaScript.html - client-side app logic, pulled into Index.html via include()
 *
 * Setup:
 *   1. Project Settings > Script Properties > add a property named
 *      VOSheet whose value is the target spreadsheet's ID (or full URL
 *      - either works, the ID is extracted automatically).
 *   2. The sheet's header row must contain the columns listed in
 *      EXPECTED_HEADERS below (any order, case-insensitive). If a
 *      tab named "Data" exists it is used; otherwise the first tab
 *      is used.
 *   3. Deploy > New deployment > Web app.
 *      - Execute as: Me
 *      - Who has access: Anyone within your organization (recommended
 *        for an internal tool), or restrict further as needed.
 */

var EXPECTED_HEADERS = [
  'Vault ID',
  'Vault Name',
  'Applications',
  'Domain Name',
  'Domain Type',
  'POD',
  'Customer Name',
  'Account ID',
  'Family',
  'Vault Type'
];

function doGet(e) {
  return HtmlService.createTemplateFromFile('Index')
    .evaluate()
    .setTitle('P1 POD Outage Lookup')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/**
 * Pulls the contents of another HTML file (Stylesheet.html, JavaScript.html)
 * into Index.html at render time. Used via <?!= include('Filename'); ?>
 * scriptlets in Index.html.
 */
function include(filename) {
  return HtmlService.createHtmlOutputFromFile(filename).getContent();
}

/**
 * Pulls the spreadsheet ID out of the VOSheet script property, which may
 * hold either a bare ID or a full Google Sheets URL.
 */
function getSpreadsheetId_() {
  var raw = PropertiesService.getScriptProperties().getProperty('VOSheet');
  if (!raw) {
    throw new Error(
      'Script property "VOSheet" is not set. Add it under ' +
      'Project Settings > Script Properties with the spreadsheet ID or URL as the value.'
    );
  }
  var match = raw.match(/[-\w]{25,}/);
  return match ? match[0] : raw;
}

function getSheet_() {
  var ss = SpreadsheetApp.openById(getSpreadsheetId_());
  var sheet = ss.getSheetByName('Data');
  if (!sheet) sheet = ss.getSheets()[0];
  return sheet;
}

/**
 * Reads the full data range once and returns it in a compact shape:
 *   { headers: [...], rows: [[...], [...]], fetchedAt: ISOString }
 * Rows are arrays (not per-row objects) to keep the payload reasonably
 * small at ~30K rows. Columns are matched to EXPECTED_HEADERS by name
 * (case-insensitive) so the sheet's actual column order doesn't matter;
 * a column missing from the sheet comes back as an empty string.
 */
function getData() {
  var sheet = getSheet_();
  var values = sheet.getDataRange().getValues();

  if (values.length === 0) {
    return { headers: EXPECTED_HEADERS, rows: [], fetchedAt: new Date().toISOString() };
  }

  var rawHeaders = values.shift().map(function (h) { return String(h).trim(); });
  var lowerRaw = rawHeaders.map(function (h) { return h.toLowerCase(); });

  var colIndex = EXPECTED_HEADERS.map(function (expected) {
    return lowerRaw.indexOf(expected.toLowerCase());
  });

  var rows = values
    .filter(function (r) { return r.join('') !== ''; })
    .map(function (r) {
      return colIndex.map(function (idx) {
        return idx === -1 ? '' : r[idx];
      });
    });

  return {
    headers: EXPECTED_HEADERS,
    rows: rows,
    fetchedAt: new Date().toISOString()
  };
}
